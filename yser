<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Work Tab Virtual System File</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #0f172a;
      color: #e2e8f0;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 2rem;
    }

    .work-tab {
      width: min(920px, 100%);
      border: 1px solid #334155;
      border-radius: 1rem;
      overflow: hidden;
      background: #111827;
      box-shadow: 0 24px 80px rgb(0 0 0 / 35%);
    }

    .tab-bar {
      display: flex;
      gap: .5rem;
      padding: .75rem .75rem 0;
      background: #020617;
    }

    .tab {
      border: 1px solid #334155;
      border-bottom: 0;
      border-radius: .75rem .75rem 0 0;
      padding: .7rem 1rem;
      background: #1e293b;
      color: #94a3b8;
      font-weight: 700;
    }

    .tab.active {
      background: #111827;
      color: #f8fafc;
    }

    main {
      padding: 2rem;
    }

    .mount-card {
      display: grid;
      gap: 1rem;
      border: 1px solid #334155;
      border-radius: .9rem;
      padding: 1.25rem;
      background: linear-gradient(135deg, rgb(30 41 59 / 90%), rgb(15 23 42 / 90%));
    }

    .mount-header {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
    }

    .badge {
      border: 1px solid #22c55e;
      color: #86efac;
      border-radius: 999px;
      padding: .35rem .75rem;
      font-size: .85rem;
      font-weight: 700;
      background: rgb(34 197 94 / 10%);
    }

    .mount-path {
      display: flex;
      align-items: center;
      gap: .75rem;
      border-radius: .75rem;
      padding: 1rem;
      background: #020617;
      border: 1px dashed #475569;
      font-family: "SFMono-Regular", Consolas, monospace;
      color: #bfdbfe;
      overflow-wrap: anywhere;
    }

    .file-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: .8rem;
      margin-top: .5rem;
    }

    .file {
      border: 1px solid #334155;
      border-radius: .75rem;
      padding: .9rem;
      background: #0f172a;
    }

    .file strong {
      display: block;
      color: #f8fafc;
      margin-bottom: .25rem;
    }

    .file span {
      color: #94a3b8;
      font-size: .9rem;
    }
  </style>
</head>
<body>
  <section class="work-tab" aria-labelledby="work-title">
    <nav class="tab-bar" aria-label="Workspace tabs">
      <div class="tab active">Work</div>
      <div class="tab">Preview</div>
      <div class="tab">Logs</div>
    </nav>
    <main>
      <div class="mount-card">
        <div class="mount-header">
          <div>
            <h1 id="work-title">Virtual system file mounted</h1>
            <p>The work tab now exposes a read-only virtual system mount for quick inspection.</p>
          </div>
          <span class="badge">Mounted</span>
        </div>
        <div class="mount-path" aria-label="Virtual mount path">
          <span>🗂️</span>
          <code>/work/system.virtualfs</code>
        </div>
        <div class="file-grid" aria-label="Virtual system files">
          <article class="file">
            <strong>kernel.info</strong>
            <span>Virtual metadata and runtime details</span>
          </article>
          <article class="file">
            <strong>mounts.json</strong>
            <span>Mounted workspace resources</span>
          </article>
          <article class="file">
            <strong>health.log</strong>
            <span>System status events</span>
          </article>
        </div>
      </div>
    </main>
  </section>
</body>
</html>
